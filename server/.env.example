# Settings for the DIC API. Copy to .env for local development (npm run dev);
# on Cloudflare, put the plain ones under [vars] in wrangler.toml and the
# secrets (marked SECRET) with `npx wrangler secret put NAME`.

# ---- Required in production ------------------------------------------------
# A long random string (e.g. from `openssl rand -hex 32`). SECRET
AUTH_SECRET=
# The website's address(es), comma-separated. Only these may call the API.
ALLOWED_ORIGINS=https://www.nyushdic.com,https://geemir.github.io
# Organisers: these sign-ins see the admin page. Comma-separated.
ADMIN_EMAILS=shanghai.dic@nyu.edu

# ---- Email (the sign-in codes) ---------------------------------------------
# aliyun (Alibaba Cloud DirectMail), resend (resend.com), webhook (POST to
# EMAIL_WEBHOOK_URL), console (print in the log; development), none
# (development with DEV_RETURN_CODE=1)
EMAIL_PROVIDER=aliyun
# With aliyun, this must be a sender address set up in the DirectMail console.
EMAIL_FROM=NYUSH DIC <noreply@mail.nyushdic.com>
EMAIL_REPLY_TO=shanghai.dic@nyu.edu
# Alibaba Cloud DirectMail: the region of the sending domain (cn-hangzhou,
# ap-southeast-1, …) and the AccessKey of a RAM user allowed only to send mail.
ALIYUN_DM_REGION=cn-hangzhou
ALIYUN_ACCESS_KEY_ID=
# SECRET
ALIYUN_ACCESS_KEY_SECRET=
# Resend (EMAIL_PROVIDER=resend). SECRET
# RESEND_API_KEY=
# EMAIL_WEBHOOK_URL=
# EMAIL_WEBHOOK_SECRET=

# Sign-in codes one network address may request per hour. Students on
# campus Wi-Fi share one public address, so keep this generous.
# CODE_LIMIT_PER_ADDRESS_HOUR=300

# ---- Deadlines (China time) ------------------------------------------------
# After this, people can't register or change teams (admins still can).
# REGISTRATION_CLOSES=2026-11-30T23:59:00+08:00
# After this, the repository link and project details lock too.
# PROJECT_EDIT_CLOSES=2026-12-04T23:59:00+08:00
# TEAM_MAX=3

# ---- Team-up ---------------------------------------------------------------
# 0 = only signed-in people can read the cards.
# BOARD_PUBLIC_READ=1
# BOARD_MAX_OPEN_POSTS=3

# ---- The assistant (off unless BOT_PROVIDER is set) ------------------------
# deepseek = DeepSeek (the club's choice); anthropic = Claude (not offered
# in Hong Kong or the mainland); echo = a stand-in that repeats the question.
# BOT_PROVIDER=deepseek
# SECRET
# DEEPSEEK_API_KEY=
# BOT_MODEL=deepseek-v4-pro
# BOT_THINKING=0
# SECRET (Claude only)
# ANTHROPIC_API_KEY=
# BOT_EFFORT=low
# BOT_KNOWLEDGE_URL=https://www.nyushdic.com/assets/dic2026/knowledge.txt
# BOT_NAME=DIC Assistant
# BOT_REQUIRE_LOGIN=0
# BOT_MAX_TOKENS=8000
# Questions per person per hour (signed-out visitors: five times this per
# network address); BOT_LIMIT_PER_DAY caps everyone together.
# BOT_LIMIT_PER_HOUR=30
# BOT_LIMIT_PER_DAY=2000

# ---- Node server only ------------------------------------------------------
# PORT=8787
# HOST=127.0.0.1
# DATABASE_PATH=./data/dic.sqlite
# TRUST_PROXY=1

# ---- Local development -----------------------------------------------------
# DIC_ENV=development relaxes the checks above, and with DEV_RETURN_CODE=1
# the sign-in code shows on the page instead of needing an email.
# DIC_ENV=development
# DEV_RETURN_CODE=1
